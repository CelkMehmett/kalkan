from typing import Optional, Sequence

KINDS: list[str]
__version__: str

class Entity:
    kind: str
    text: str
    start: int
    end: int
    confidence: int
    def to_dict(self) -> dict: ...

class LeakReport:
    clean: bool
    new_pii: list[tuple[str, str]]
    echoed_originals: list[str]
    unknown_placeholders: list[str]
    def __bool__(self) -> bool: ...

class StreamRestorer:
    def push(self, chunk: str) -> str: ...
    def finish(self) -> str: ...

class Session:
    def mask(self, text: str) -> str: ...
    def mask_detailed(self, text: str) -> tuple[str, list[Entity]]: ...
    def restore(self, text: str) -> str: ...
    def audit(self, raw_response: str) -> LeakReport: ...
    def stream(self) -> StreamRestorer: ...
    @property
    def vault(self) -> dict[str, str]: ...
    def import_vault(self, vault: dict[str, str]) -> None: ...
    def __len__(self) -> int: ...

class Kalkan:
    def __init__(
        self,
        strategy: str = "token",
        kinds: Optional[Sequence[str]] = None,
        exclude: Optional[Sequence[str]] = None,
        min_confidence: int = 70,
        secret: Optional[int] = None,
        terms: Optional[Sequence[str]] = None,
    ) -> None: ...
    def detect(self, text: str) -> list[Entity]: ...
    def mask(self, text: str) -> str: ...
    def contains_pii(self, text: str) -> bool: ...
    def session(self) -> Session: ...
    def mask_batch(self, texts: Sequence[str], threads: Optional[int] = None) -> list[str]: ...
    def detect_batch(self, texts: Sequence[str], threads: Optional[int] = None) -> list[list[Entity]]: ...

def is_valid_tckn(s: str) -> bool: ...
def is_valid_vkn(s: str) -> bool: ...
def is_valid_iban(s: str) -> bool: ...
def luhn_valid(s: str) -> bool: ...
